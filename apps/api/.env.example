# Copy this file to .env (never commit .env).

# Matches docker-compose.yml. For Neon, paste its connection string instead.
DATABASE_URL="postgresql://lightkeeper:lightkeeper@localhost:5432/lightkeeper?schema=public"

PORT=3000

# Run the page checker inside the API process (fine for development).
CHECKER_ENABLED=true
# How often the scheduler looks for pages that are due, in seconds.
CHECKER_TICK_SECONDS=60

# Lets watches point at localhost / private network addresses (needed for the local test page).
# Set to false on a public server so nobody can make it fetch internal addresses.
ALLOW_PRIVATE_URLS=true

# Identifies the checker to websites. Put a real contact address before going public.
USER_AGENT="LightkeeperBot/0.1 (+https://github.com/PaVaN1063/lightkeeper)"
