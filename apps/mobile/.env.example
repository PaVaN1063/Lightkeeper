# Copy to .env in this folder. Restart `npm start` / `npm run web` after changing it.

# Where the Lightkeeper API runs. Leave unset for: web → http://localhost:3000, Android emulator → http://10.0.2.2:3000.
# For a real phone on the same Wi-Fi, use your laptop's IP (run `ipconfig` and look for IPv4 Address):
# EXPO_PUBLIC_API_URL=http://192.168.1.6:3000
