{
  "name": "lightkeeper-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "setup": "expo install react react-native react-dom react-native-web @expo/metro-runtime expo-router expo-linking expo-constants expo-status-bar expo-system-ui expo-font react-native-safe-area-context react-native-screens react-native-svg @react-native-async-storage/async-storage @expo/vector-icons @expo-google-fonts/bricolage-grotesque @expo-google-fonts/figtree && expo install --dev typescript @types/react"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
